---
import type { Ability } from "../../pokeapi/pokemon";

interface Props {
  abilities: Ability[];
}

const { abilities } = Astro.props;
---

<div>
  <span class="text-lg font-bold">Abilities:</span>

  <ul>
    {
      abilities.map(({ ability: { name }, is_hidden }) =>
        !is_hidden ? (
          <li class="capitalize">{name.replaceAll("-", " ")}</li>
        ) : (
          <li class="capitalize text-gray-600">{name.replaceAll("-", " ")}</li>
        ),
      )
    }
  </ul>
</div>
