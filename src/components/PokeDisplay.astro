---
import TypeCards from "./pokemon/TypeCards.astro";
import AbilityList from "./pokemon/AbilityList.astro";
import { substitute, type Pokemon } from "../pokeapi/pokemon";
import PokeName from "./pokemon/PokeName.astro";
import { Image } from "astro:assets";

interface Props {
  pokemon: Pokemon;
  loading?: "eager" | "lazy";
  index?: number;
}

const { pokemon, loading = "eager", index = 0 } = Astro.props;

console.log(pokemon.image?.srcSet.attribute);
---

<section
  class="py-1 flex flex-col md:flex-row px-2 gap-6 mix-blend-normal"
  transition:name={`pokemon-display-${index}`}
>
  <Image
    class="border border-slate-600 dark:border-slate-400 rounded-lg px-2 [image-rendering:pixelated] bg-transparent bg-clip-padding"
    alt={pokemon?.name ? `Image of ${pokemon.name}` : "Substitute image"}
    loading={loading}
    src={pokemon.image?.src || substitute.src}
    height={434}
    width={450}
    layout="constrained"
  />

  <article class="flex-1">
    <div class="pt-2 mb-5 flex flex-col md:gap-y-2 items-center md:items-start">
      <PokeName name={pokemon.name} id={pokemon.id} />
      <TypeCards types={pokemon.types} />
    </div>

    <div
      class="mx-auto md:mx-0 md:w-min lg:w-full flex md:px-0 px-4 flex-row flex-wrap gap-4 md:gap-x-6 justify-around md:justify-between"
    >
      <AbilityList abilities={pokemon.abilities} />

      <table
        class="flex flex-col bg-gray-300 dark:bg-gray-800 px-4 py-2 md:px-6 rounded md:min-w-45 items-center"
      >
        <thead>
          <th class="block text-center font-bold pb-1">Info</th>
        </thead>
        <tbody class="w-full">
          <tr class="flex flex-row gap-x-3 justify-around md:justify-between">
            <th>Height:</th>
            <td>{pokemon.height / 10}m</td>
          </tr>
          <tr class="flex flex-row gap-x-3 justify-around md:justify-between">
            <th>Weight:</th>
            <td>{pokemon.weight / 10}kg</td>
          </tr>
        </tbody>
      </table>
    </div>
  </article>
</section>
