---
import type { Ability } from "../../pokeapi/pokemon";

interface Props {
  abilities: Ability[];
}

const { abilities } = Astro.props;
---

<div class="bg-gray-300 dark:bg-gray-800 px-4 py-2 md:px-6 rounded md:min-w-45">
  <span class="block text-center text-lg font-bold mb-1">Abilities</span>

  <ul>
    {
      abilities.map(({ ability: { name }, is_hidden }) =>
        !is_hidden ? (
          <li class="capitalize">{name.replaceAll("-", " ")}</li>
        ) : (
          <li class="capitalize opacity-50">{name.replaceAll("-", " ")}</li>
        ),
      )
    }
  </ul>
</div>
