---
import { colorMap, type Type } from "../../pokeapi/pokemon";

interface Props {
  types: Type[];
}

const { types } = Astro.props;
---

<ul class="flex flex-wrap flex-row gap-2">
  {
    types.map(({ type: { name } }) => (
      <li
        class="bg-(--typeColor) capitalize rounded-md block px-2 py-1 text-sm text-white"
        style={{ "--typeColor": colorMap[name] }}
      >
        {name}
      </li>
    ))
  }
</ul>
