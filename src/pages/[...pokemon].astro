---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import PokeDisplay from "../components/PokeDisplay.astro";
import { pokemons, type Species } from "../pokeapi/pokemon";
import { Icon } from "astro-icon/components";

export const prerender = true;

interface Props {
  species: Species;
  mode?: "name" | "number" | "undefined";
  next?: Species;
  last?: Species;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const nameRoutes = pokemons.map((species) => ({
    params: { pokemon: `${species.name}/` },
    props: {
      species,
      last: pokemons[species.id - 2],
      next: pokemons[species.id],
    },
  }));

  const numberRoutes = pokemons.map((species) => ({
    params: { pokemon: `${species.id}/` },
    props: {
      species,
      mode: "number",
      last: pokemons[species.id - 2],
      next: pokemons[species.id],
    },
  }));

  return [
    {
      params: { pokemon: "/" },
      props: nameRoutes[0]!.props,
    },
    ...nameRoutes,
    ...numberRoutes,
  ];
};

console.log(Astro.url.pathname);

function capitalize(sentence: string) {
  return sentence
    .split(" ")
    .map((word) => word[0]?.toUpperCase() + word.substring(1).toLowerCase())
    .join(" ");
}

const { species, last, next, mode } = Astro.props;

function pokeUrl(species: Species) {
  return `${import.meta.env.BASE_URL}/${mode === "number" ? species.id : species.name}/`;
}
---

<Base title={capitalize(species.name.replace("-", " "))}>
  <Fragment slot="head">
    {
      [...(last?.pokemons || []), ...(next?.pokemons || [])].map(
        (pokemon) =>
          pokemon.image && (
            <link rel="preload" href={pokemon.image.src} as="image" />
          ),
      )
    }

    {last && <link rel="prefetch" href={pokeUrl(last)} />}
    {next && <link rel="prefetch" href={pokeUrl(next)} />}
  </Fragment>

  <main class="flex flex-row place-items-center justify-center">
    {
      last ? (
        <a
          href={last ? pokeUrl(last) : ""}
          data-astro-prefetch="load"
          id="last"
          aria-label="Go back to last Pokemon"
          aria-disabled={!last}
          class="flex-1 h-full justify-end items-center px-5 hidden md:flex"
        >
          <Icon name="mdi:menu-left-outline" size={60} />
        </a>
      ) : (
        <div class="flex-1 h-full justify-end items-center px-5 hidden md:flex" />
      )
    }

    <div
      class="lg:min-w-220 flex flex-col gap-y-4 md:max-h-dvh md:overflow-auto py-6"
    >
      {
        species.pokemons.map((pokemon, index) => (
          <PokeDisplay
            pokemon={pokemon}
            loading={index < 3 ? "eager" : "lazy"}
            index={index}
          />
        ))
      }
    </div>

    {
      next ? (
        <a
          href={next ? pokeUrl(next) : ""}
          data-astro-prefetch="load"
          id="next"
          aria-label="Go to next Pokemon"
          aria-disabled={!next}
          class="flex-1 h-full justify-start items-center px-5 hidden md:flex"
        >
          <Icon name="mdi:menu-right-outline" size={60} />
        </a>
      ) : (
        <div class="flex-1 h-full justify-start items-center px-5 hidden md:flex" />
      )
    }
  </main>
</Base>

<script>
  let anchorNext: HTMLAnchorElement | null;
  let anchorLast: HTMLAnchorElement | null;
  let gestureZone: HTMLElement;

  function setActions() {
    anchorNext = document.getElementById("next") as HTMLAnchorElement | null;
    anchorLast = document.getElementById("last") as HTMLAnchorElement | null;
    gestureZone = document.getElementsByTagName("main")![0]!;

    gestureZone.addEventListener("touchstart", (e) => {
      touchstartX = e?.changedTouches[0]?.screenX || 0;
      console.log("Touch start:", touchstartX);
    });

    gestureZone.addEventListener("touchend", (e) => {
      touchendX = e?.changedTouches[0]?.screenX || 0;
      console.log("Touch end:", touchendX);
      handleGesture();
    });
  }

  document.addEventListener("astro:after-swap", setActions);
  setActions();

  document.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight" || event.key === "ArrowDown")
      anchorNext?.click();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowUp")
      anchorLast?.click();
  });

  let touchstartX = 0;
  let touchendX = 0;

  function handleGesture() {
    const screenSize = window.innerWidth;
    const threshold = Math.min(100, screenSize * 0.2);

    if (touchendX < touchstartX - threshold) {
      anchorNext?.click();
    } else if (touchendX > touchstartX + threshold) {
      anchorLast?.click();
    }
  }
</script>
